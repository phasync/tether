        "phasync/tether": "@dev",
        "phasync/swerve": "@dev",
        "fubber/mini": "@dev"
    },
    "autoload": { "psr-4": { "Demo\\": "src/" } },
    "repositories": [
        { "type": "path", "url": "../..", "options": { "symlink": true } },
