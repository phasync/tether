{
    "name": "phasync/tether-playground-laravel",
    "description": "Tether pages in Laravel with Blade, on swerve through phasync/swerve-laravel",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "laravel/framework": "^13.0",
        "phasync/swerve-laravel": "@dev",
        "phasync/tether": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../../../swerve-laravel",
            "options": {
                "symlink": true
            }
        }
    ],
    "extra": {
        "phasync": {
            "ext": true
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
