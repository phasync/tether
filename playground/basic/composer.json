{
    "name": "phasync/tether-playground-basic",
    "description": "A plain mini application, to prove mini runs on swerve as it runs on PHP-FPM",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "fubber/mini": "@dev",
        "phasync/swerve": "^0.1.0-beta5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../mini-framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "phasync": {
            "ext": true
        }
    }
}
