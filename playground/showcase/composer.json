{
    "name": "phasync/tether-playground-showcase",
    "description": "Everything Tether can do on one page: events, interop and hooks, bound from server-side code",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "phasync/tether": "@dev",
        "phasync/swerve": "^0.1.0-beta5"
    },
    "autoload": {
        "psr-4": {
            "Showcase\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "phasync": {
            "ext": true
        }
    }
}
