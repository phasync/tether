{
    "name": "phasync/tether",
    "description": "Live server-side components for PHP: each browser tab is tethered to its component state on the server. For any PSR-15 application on the swerve application server.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frodeborli@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "phasync/phasync": "^2.0.0-alpha6",
        "phasync/swerve": "@dev"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "fubber/mini": "@dev"
    },
    "autoload": {
        "psr-4": {
            "Tether\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tether\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../swerve",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../mini-framework",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "alpha",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
